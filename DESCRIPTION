Package: bibliolatam
Title: Latin American Bibliographic Data Parsers for 'bibliometrix'
Version: 1.0.0
Authors@R: c(
    person(
      given = "Gabriel",
      family = "Gama",
      role = c("aut", "cre", "cph"),
